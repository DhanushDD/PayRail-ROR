#!/usr/bin/env ruby
# frozen_string_literal: true

# PayRail Interview Handbook Verification CLI
# Boots Rails environment and executes all codes, questions (Q1-Q169),
# 20 cheat sheet pairs, and follow-up architecture patterns from the notes.

