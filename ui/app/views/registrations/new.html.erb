<div class="max-w-md mx-auto py-8 sm:py-12">
  <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm">
    
    <div class="text-center mb-8">
      <div class="inline-flex items-center space-x-1 mb-3">
        <div class="w-10 h-10 rounded-2xl bg-[#003087] flex items-center justify-center shadow-sm">
          <span class="text-xl font-black italic tracking-tighter text-white">P</span>
          <span class="text-xl font-black italic tracking-tighter text-[#00BAF2] -ml-1">R</span>
        </div>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Create your account</h1>
      <p class="text-xs text-slate-500 mt-1">Sign up for PayRail authentication &amp; API access</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700">
        <ul class="list-disc pl-4 space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path, local: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Full Legal Name</label>
        <%= f.text_field :name, placeholder: "e.g. Dhanush Daran", required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email address</label>
        <%= f.email_field :email, placeholder: "dhanush@example.com", required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">PayRail Handle ($tag)</label>
        <div class="relative">
          <span class="absolute left-4 top-3 text-[#0070BA] font-bold text-sm">$</span>
          <%= f.text_field :payrail_tag, placeholder: "dhanush", required: true, class: "w-full pl-8 pr-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm font-mono placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Password</label>
        <%= f.password_field :password, placeholder: "At least 6 characters", required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Confirm Password</label>
        <%= f.password_field :password_confirmation, required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Agree & Create Account", class: "w-full py-3.5 bg-[#0070BA] hover:bg-[#003087] text-white font-bold rounded-full shadow-sm text-sm transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 pt-5 border-t border-slate-200 text-center">
      <p class="text-xs text-slate-500">
        Already have an account?
        <a href="<%= login_path %>" class="text-[#0070BA] font-bold hover:underline ml-1">Log In</a>
      </p>
    </div>

  </div>
</div>
