<div class="max-w-xl mx-auto py-6">
  
  <!-- PayPal Clean White Payment Card -->
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm">
    
    <!-- Tab Controls: Send | Request -->
    <div class="flex items-center justify-center space-x-6 border-b border-slate-200 pb-4 mb-6">
      <button type="button" class="text-base font-bold text-[#0070BA] border-b-2 border-[#0070BA] pb-4 -mb-4 transition">
        Send Payment
      </button>
      <a href="<%= payment_links_path %>" class="text-base font-semibold text-slate-500 hover:text-slate-800 transition pb-4 -mb-4">
        Request Payment
      </a>
    </div>

    <!-- Available Balance Sub-banner -->
    <div class="mb-6 p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-[#0070BA] flex items-center justify-center font-bold text-xs">
          $
        </div>
        <div>
          <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">PayRail Balance</div>
          <div class="text-base font-extrabold text-slate-900 font-sans"><%= @wallet.formatted_balance %></div>
        </div>
      </div>
      <button type="button" onclick="document.getElementById('depositModal').classList.remove('hidden')" class="text-xs font-bold text-[#0070BA] hover:underline">
        + Add Money
      </button>
    </div>

    <%= form_with url: transfers_path, method: :post, local: true, id: "transferForm", class: "space-y-5" do |f| %>
      
      <!-- Recipient Input -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Recipient</label>
        <div class="relative">
          <span class="absolute left-4 top-3.5 text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
          <%= f.text_field :recipient, id: "recipientInput", value: @preset_recipient, placeholder: "Name, $tag, or email", required: true, class: "w-full pl-11 pr-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm font-medium placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
        </div>

        <!-- Autocomplete Suggestions -->
        <div id="recipientSuggestions" class="hidden mt-2 p-2 bg-white border border-slate-200 rounded-xl shadow-md space-y-1"></div>

        <!-- Recent Contacts -->
        <div class="mt-3 flex items-center space-x-2 overflow-x-auto pb-1 text-xs">
          <span class="text-slate-400 font-medium text-[11px] flex-shrink-0">Recent:</span>
          <% @peers.each do |peer| %>
            <button type="button" onclick="selectPeer('<%= peer.payrail_tag %>')" class="flex-shrink-0 px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition">
              <%= peer.name.split.first %> (<%= peer.payrail_tag %>)
            </button>
          <% end %>
        </div>
      </div>

      <!-- Amount Input (PayPal big number style) -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Amount</label>
        <div class="relative">
          <span class="absolute left-4 top-3 text-3xl font-bold text-slate-400">$</span>
          <%= f.number_field :amount, id: "amountInput", step: 0.01, min: 0.50, placeholder: "0.00", required: true, class: "w-full pl-11 pr-16 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-3xl font-bold font-sans placeholder-slate-300 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
          <span class="absolute right-4 top-4 text-xs font-bold text-slate-400">USD</span>
        </div>

        <!-- Quick Increments -->
        <div class="mt-2.5 flex items-center gap-2">
          <button type="button" onclick="setAmount(10)" class="px-3.5 py-1 bg-slate-100 hover:bg-slate-200 rounded-full text-xs font-semibold text-slate-700 transition">+$10</button>
          <button type="button" onclick="setAmount(50)" class="px-3.5 py-1 bg-slate-100 hover:bg-slate-200 rounded-full text-xs font-semibold text-slate-700 transition">+$50</button>
          <button type="button" onclick="setAmount(100)" class="px-3.5 py-1 bg-slate-100 hover:bg-slate-200 rounded-full text-xs font-semibold text-slate-700 transition">+$100</button>
          <button type="button" onclick="setAmount(500)" class="px-3.5 py-1 bg-slate-100 hover:bg-slate-200 rounded-full text-xs font-semibold text-slate-700 transition">+$500</button>
        </div>
      </div>

      <!-- Category / Protection Option (PayPal signature) -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Payment Type</label>
        <%= f.select :category, [
          ["Sending to a friend / Peer Transfer", "transfer"],
          ["Goods and Services (With Buyer Protection)", "shopping"],
          ["Dining & Food reimbursement", "dining"],
          ["Professional Consulting / Services", "services"],
          ["Utilities & Household bills", "utilities"]
        ], {}, class: "w-full px-3.5 py-3 bg-white border border-slate-300 rounded-xl text-slate-800 text-sm font-medium focus:outline-none focus:border-[#0070BA]" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">What's this for? (Note)</label>
        <%= f.text_field :description, placeholder: "Add a note (e.g. Dinner, Rent, Consulting)", class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:border-[#0070BA]" %>
      </div>

      <!-- Summary Note -->
      <div class="p-3.5 rounded-xl bg-blue-50/60 border border-blue-100 text-xs text-slate-600 flex items-center justify-between">
        <span>Transfer Fee:</span>
        <span class="font-bold text-emerald-700 font-sans">$0.00 USD (Free)</span>
      </div>

      <div class="pt-2">
        <%= f.submit "Send Payment Now", class: "w-full py-4 bg-[#0070BA] hover:bg-[#003087] text-white font-bold rounded-full text-sm shadow-md transition cursor-pointer" %>
      </div>
    <% end %>

  </div>
</div>

<script>
  function selectPeer(tag) {
    document.getElementById('recipientInput').value = tag;
  }

  function setAmount(val) {
    const input = document.getElementById('amountInput');
    const curr = parseFloat(input.value) || 0;
    input.value = (curr + val).toFixed(2);
  }

  const recipientInput = document.getElementById('recipientInput');
  const suggestionsBox = document.getElementById('recipientSuggestions');

  recipientInput.addEventListener('input', function() {
    const q = this.value.trim();
    if (q.length < 2) {
      suggestionsBox.classList.add('hidden');
      return;
    }

    fetch(`/transfers/lookup?q=${encodeURIComponent(q)}`)
      .then(res => res.json())
      .then(users => {
        if (users.length === 0) {
          suggestionsBox.classList.add('hidden');
          return;
        }

        suggestionsBox.innerHTML = users.map(u => `
          <div onclick="selectPeer('${u.payrail_tag}')" class="p-2.5 hover:bg-slate-50 rounded-xl cursor-pointer flex items-center justify-between text-xs transition">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs text-white" style="background-color: ${u.avatar_color}">
                ${u.name.substring(0, 2).toUpperCase()}
              </span>
              <span class="font-bold text-slate-800">${u.name}</span>
            </div>
            <span class="font-mono text-[#0070BA] font-bold">${u.payrail_tag}</span>
          </div>
        `).join('');

        suggestionsBox.classList.remove('hidden');
      });
  });
</script>
