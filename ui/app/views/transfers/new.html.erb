<div class="max-w-2xl mx-auto py-4">
  
  <div class="mb-6">
    <a href="<%= dashboard_path %>" class="text-xs font-semibold text-slate-400 hover:text-white flex items-center space-x-1 mb-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Dashboard</span>
    </a>
    <h1 class="text-2xl font-black text-white tracking-tight">Send Money Instantly</h1>
    <p class="text-xs text-slate-400 mt-1">Real-time peer-to-peer settlement protected by double-entry ledger verification</p>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 lg:p-8 shadow-xl">
    
    <!-- Balance Available Pill -->
    <div class="mb-6 p-4 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between">
      <div>
        <div class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Available in Primary Wallet</div>
        <div class="text-xl font-extrabold text-white font-mono mt-0.5"><%= @wallet.formatted_balance %></div>
      </div>
      <button type="button" onclick="document.getElementById('depositModal').classList.remove('hidden')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
        + Top Up
      </button>
    </div>

    <%= form_with url: transfers_path, method: :post, local: true, id: "transferForm", class: "space-y-5" do |f| %>
      
      <!-- Recipient Input with Live Lookup Feedback -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Recipient Identifier</label>
          <span class="text-[11px] text-slate-400">Enter PayRail tag (e.g. <code class="text-brand-400 font-mono">$alice</code>) or email</span>
        </div>
        <div class="relative">
          <span class="absolute left-3.5 top-3 text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </span>
          <%= f.text_field :recipient, id: "recipientInput", value: @preset_recipient, placeholder: "$alice, $bob, or user@payrail.io", required: true, class: "w-full pl-10 pr-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono placeholder-slate-500 focus:outline-none focus:border-brand-500 transition" %>
        </div>

        <!-- Live Recipient Search Autocomplete Dropdown -->
        <div id="recipientSuggestions" class="hidden mt-2 p-2 bg-slate-950 border border-slate-800 rounded-xl space-y-1"></div>

        <!-- Peer Quick Chips -->
        <div class="mt-3 flex items-center space-x-2 overflow-x-auto pb-1 text-xs">
          <span class="text-[11px] text-slate-400 flex-shrink-0">Frequent:</span>
          <% @peers.each do |peer| %>
            <button type="button" onclick="selectPeer('<%= peer.payrail_tag %>')" class="flex-shrink-0 px-2.5 py-1 rounded-lg bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 font-mono text-[11px] transition">
              <%= peer.payrail_tag %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Amount Input with Quick Pills -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Amount to Send (USD)</label>
        <div class="relative">
          <span class="absolute left-4 top-3 text-2xl font-black text-slate-400">$</span>
          <%= f.number_field :amount, id: "amountInput", step: 0.01, min: 0.50, placeholder: "0.00", required: true, class: "w-full pl-10 pr-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white text-2xl font-black font-mono placeholder-slate-600 focus:outline-none focus:border-brand-500 transition" %>
        </div>

        <!-- Quick Amount Increments -->
        <div class="mt-2.5 flex items-center gap-2">
          <button type="button" onclick="setAmount(10)" class="px-3 py-1 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-xs font-semibold text-slate-300 transition">+$10</button>
          <button type="button" onclick="setAmount(50)" class="px-3 py-1 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-xs font-semibold text-slate-300 transition">+$50</button>
          <button type="button" onclick="setAmount(100)" class="px-3 py-1 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-xs font-semibold text-slate-300 transition">+$100</button>
          <button type="button" onclick="setAmount(500)" class="px-3 py-1 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-xs font-semibold text-slate-300 transition">+$500</button>
        </div>
      </div>

      <!-- Category & Note Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Category</label>
          <%= f.select :category, [
            ["Transfer / General", "transfer"],
            ["Dining & Food", "dining"],
            ["Shopping & Retail", "shopping"],
            ["Tech Services / Consulting", "services"],
            ["Utilities & Bills", "utilities"]
          ], {}, class: "w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs focus:outline-none focus:border-brand-500" %>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Reference Note</label>
          <%= f.text_field :description, placeholder: "e.g. Project lunch, Retainer fee", class: "w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-brand-500" %>
        </div>
      </div>

      <!-- Transfer Summary Breakdown Box -->
      <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-2 text-xs">
        <div class="flex items-center justify-between text-slate-400">
          <span>Transfer Rail:</span>
          <span class="text-white font-semibold">PayRail Internal High-Speed Rail</span>
        </div>
        <div class="flex items-center justify-between text-slate-400">
          <span>Settlement Time:</span>
          <span class="text-emerald-400 font-semibold">Instant (&lt; 150ms)</span>
        </div>
        <div class="flex items-center justify-between text-slate-400">
          <span>Transfer Fee:</span>
          <span class="text-emerald-400 font-mono font-bold">$0.00 (Zero Fee)</span>
        </div>
        <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-slate-300 font-bold">
          <span>Concurrency Control:</span>
          <span class="font-mono text-[11px] text-amber-400">ACID + Pessimistic Row Lock</span>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Authorize & Execute Payment", class: "w-full py-3.5 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-bold rounded-2xl shadow-xl shadow-brand-600/30 transition text-sm cursor-pointer" %>
      </div>
    <% end %>

  </div>
</div>

<script>
  function selectPeer(tag) {
    document.getElementById('recipientInput').value = tag;
  }

  function setAmount(val) {
    const input = document.getElementById('amountInput');
    const curr = parseFloat(input.value) || 0;
    input.value = (curr + val).toFixed(2);
  }

  // Live Recipient Search Autocomplete
  const recipientInput = document.getElementById('recipientInput');
  const suggestionsBox = document.getElementById('recipientSuggestions');

  recipientInput.addEventListener('input', function() {
    const q = this.value.trim();
    if (q.length < 2) {
      suggestionsBox.classList.add('hidden');
      return;
    }

    fetch(`/transfers/lookup?q=${encodeURIComponent(q)}`)
      .then(res => res.json())
      .then(users => {
        if (users.length === 0) {
          suggestionsBox.classList.add('hidden');
          return;
        }

        suggestionsBox.innerHTML = users.map(u => `
          <div onclick="selectPeer('${u.payrail_tag}')" class="p-2 hover:bg-slate-900 rounded-lg cursor-pointer flex items-center justify-between text-xs">
            <div class="flex items-center space-x-2">
              <span class="w-6 h-6 rounded-full flex items-center justify-center font-bold text-[10px] text-white" style="background-color: ${u.avatar_color}">
                ${u.name.substring(0, 2).toUpperCase()}
              </span>
              <span class="font-semibold text-white">${u.name}</span>
            </div>
            <span class="font-mono text-brand-400 font-bold">${u.payrail_tag}</span>
          </div>
        `).join('');

        suggestionsBox.classList.remove('hidden');
      });
  });
</script>
