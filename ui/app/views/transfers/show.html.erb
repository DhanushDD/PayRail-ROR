<div class="max-w-xl mx-auto py-6">
  
  <div class="mb-4 flex items-center justify-between">
    <a href="<%= dashboard_path %>" class="text-xs font-semibold text-[#0070BA] hover:underline flex items-center space-x-1">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Dashboard</span>
    </a>
    <button onclick="window.print()" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 border border-slate-300 shadow-xs flex items-center space-x-1.5 transition">
      <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>Print Receipt</span>
    </button>
  </div>

  <!-- PayPal Authentic Confirmation Receipt Slip -->
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm">
    
    <!-- Top Green Success Icon & Title -->
    <div class="text-center pb-6 border-b border-slate-100">
      <div class="w-14 h-14 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-xs uppercase font-bold tracking-wider text-emerald-600 mb-1">Payment Completed</h2>
      <div class="text-3xl sm:text-4xl font-black text-slate-900 font-sans tracking-tight">
        <%= @transfer.formatted_amount %> <span class="text-lg font-normal text-slate-500">USD</span>
      </div>
      <p class="text-xs text-slate-500 mt-1 font-mono">
        Transaction ID: <span class="font-bold text-slate-700"><%= @transfer.reference_id %></span>
      </p>
    </div>

    <!-- Payment Details List -->
    <div class="py-5 border-b border-slate-100 space-y-3 text-xs">
      <div class="flex items-center justify-between">
        <span class="text-slate-500">Sent to:</span>
        <div class="text-right">
          <span class="font-bold text-slate-900"><%= @transfer.recipient_user ? @transfer.recipient_user.name : "Recipient" %></span>
          <span class="text-slate-400 font-mono text-[11px] block"><%= @transfer.recipient_user&.payrail_tag %></span>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-500">Sent from:</span>
        <div class="text-right">
          <span class="font-bold text-slate-900"><%= @transfer.sender_user ? @transfer.sender_user.name : "Bank Rail" %></span>
          <span class="text-slate-400 font-mono text-[11px] block"><%= @transfer.sender_user&.payrail_tag %></span>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-500">Payment method:</span>
        <span class="font-medium text-slate-800">PayRail Balance</span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-500">Note:</span>
        <span class="font-medium text-slate-800"><%= @transfer.description.presence || "None" %></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-500">Date:</span>
        <span class="text-slate-700 font-medium"><%= @transfer.created_at.strftime("%B %d, %Y at %H:%M") %></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-500">Fee:</span>
        <span class="text-emerald-700 font-bold">$0.00 USD</span>
      </div>
    </div>

    <!-- Professional Accounting Ledger Details (Clean Expandable Drawer for Reviewers) -->
    <div class="mt-5 pt-2">
      <details class="group border border-slate-200 rounded-2xl p-4 bg-slate-50/60" open>
        <summary class="flex items-center justify-between cursor-pointer text-xs font-bold text-slate-800 uppercase tracking-wide select-none">
          <span>Double-Entry Ledger Audit Trail</span>
          <span class="text-[11px] text-emerald-700 font-semibold font-mono">Balanced (Zero Drift)</span>
        </summary>

        <div class="mt-4 space-y-2 text-xs">
          <% @ledger_entries.each do |entry| %>
            <div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= entry.debit? ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200' %>">
                  <%= entry.entry_type %>
                </span>
                <span class="ml-2 font-medium text-slate-700"><%= entry.description %></span>
                <div class="text-[10px] text-slate-400 font-mono mt-0.5">
                  Wallet <%= entry.wallet.wallet_number %> &bull; Post-Balance: <%= entry.formatted_balance_after %>
                </div>
              </div>
              <div class="font-bold font-mono text-sm <%= entry.debit? ? 'text-rose-700' : 'text-emerald-700' %>">
                <%= entry.formatted_amount %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    </div>

    <!-- Actions -->
    <div class="mt-6 flex items-center space-x-3">
      <a href="<%= new_transfer_path %>" class="flex-1 py-3 bg-[#0070BA] hover:bg-[#003087] text-white font-bold text-center text-xs rounded-full shadow-sm transition">
        Send Another Payment
      </a>
      <a href="<%= dashboard_path %>" class="px-6 py-3 border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-full transition">
        Done
      </a>
    </div>

  </div>

</div>
