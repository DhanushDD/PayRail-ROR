<div class="max-w-2xl mx-auto py-4">
  
  <div class="mb-6 flex items-center justify-between">
    <a href="<%= dashboard_path %>" class="text-xs font-semibold text-slate-400 hover:text-white flex items-center space-x-1">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Dashboard</span>
    </a>
    <button onclick="window.print()" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-semibold text-slate-300 border border-slate-800 flex items-center space-x-1.5 transition">
      <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>Print Receipt</span>
    </button>
  </div>

  <!-- Official Payment Receipt Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 lg:p-8 shadow-2xl relative overflow-hidden">
    
    <!-- Top Green Success Badge -->
    <div class="text-center pb-6 border-b border-slate-800">
      <div class="w-14 h-14 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-3">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div class="text-xs uppercase tracking-widest font-bold text-emerald-400 mb-1">Payment Settled Successfully</div>
      <div class="text-3xl lg:text-4xl font-black text-white font-mono tracking-tight"><%= @transfer.formatted_amount %></div>
      <div class="text-xs text-slate-400 font-mono mt-1"><%= @transfer.reference_id %></div>
    </div>

    <!-- Payment Parties Summary -->
    <div class="py-6 border-b border-slate-800 grid grid-cols-2 gap-4 text-xs">
      <div>
        <div class="text-slate-400 uppercase tracking-wider text-[10px] font-semibold mb-1">From (Sender)</div>
        <div class="font-bold text-white"><%= @transfer.sender_user&.name || "External Payment Rail" %></div>
        <div class="text-slate-400 font-mono text-[11px]"><%= @transfer.sender_user&.payrail_tag || "RAIL-DEPOSIT" %></div>
        <div class="text-[10px] text-slate-500 font-mono"><%= @transfer.sender_wallet&.wallet_number %></div>
      </div>
      <div class="text-right">
        <div class="text-slate-400 uppercase tracking-wider text-[10px] font-semibold mb-1">To (Recipient)</div>
        <div class="font-bold text-white"><%= @transfer.recipient_user&.name %></div>
        <div class="text-brand-400 font-mono text-[11px] font-bold"><%= @transfer.recipient_user&.payrail_tag %></div>
        <div class="text-[10px] text-slate-500 font-mono"><%= @transfer.recipient_wallet&.wallet_number %></div>
      </div>
    </div>

    <!-- Metadata Attributes -->
    <div class="py-4 border-b border-slate-800 space-y-2 text-xs">
      <div class="flex items-center justify-between text-slate-400">
        <span>Payment Note:</span>
        <span class="text-white font-medium"><%= @transfer.description %></span>
      </div>
      <div class="flex items-center justify-between text-slate-400">
        <span>Transaction Category:</span>
        <span class="text-slate-300 capitalize font-medium"><%= @transfer.category %></span>
      </div>
      <div class="flex items-center justify-between text-slate-400">
        <span>Settled Timestamp:</span>
        <span class="text-slate-300 font-mono"><%= @transfer.created_at.strftime("%B %d, %Y at %H:%M:%S UTC") %></span>
      </div>
      <div class="flex items-center justify-between text-slate-400">
        <span>Network Fee:</span>
        <span class="text-emerald-400 font-mono font-bold">$0.00</span>
      </div>
    </div>

    <!-- Double-Entry Ledger Breakdown (The Accenture Engineering Highlight!) -->
    <div class="mt-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2">
          <span>Double-Entry Ledger Audit Trail</span>
          <span class="px-2 py-0.5 rounded bg-brand-500/20 text-brand-300 text-[10px] font-mono">ACID VERIFIED</span>
        </h3>
        <span class="text-[10px] font-mono text-emerald-400 font-bold">&Delta; Balance = $0.00</span>
      </div>

      <div class="space-y-2.5">
        <% @ledger_entries.each do |entry| %>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs">
            <div class="flex items-center space-x-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold <%= entry.debit? ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
                <%= entry.entry_type.upcase %>
              </span>
              <div>
                <div class="font-bold text-white"><%= entry.description %></div>
                <div class="text-[10px] text-slate-400 font-mono">
                  Wallet: <%= entry.wallet.wallet_number %> &bull; Post-Balance: <strong class="text-slate-300"><%= entry.formatted_balance_after %></strong>
                </div>
              </div>
            </div>
            <div class="font-mono font-bold text-sm <%= entry.debit? ? 'text-rose-400' : 'text-emerald-400' %>">
              <%= entry.formatted_amount %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Invariant Check Banner -->
      <div class="mt-4 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between text-xs text-emerald-400 font-semibold">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Ledger Invariant Validated: Total Debits == Total Credits</span>
        </div>
        <span class="font-mono text-[11px] font-bold">100% Balanced</span>
      </div>
    </div>

    <!-- Actions Row -->
    <div class="mt-8 pt-6 border-t border-slate-800 flex items-center justify-between gap-4">
      <a href="<%= dashboard_path %>" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs transition">
        Return to Dashboard
      </a>
      <a href="<%= new_transfer_path %>" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs shadow-lg shadow-brand-600/30 transition">
        Send Another Payment &rarr;
      </a>
    </div>

  </div>

</div>
