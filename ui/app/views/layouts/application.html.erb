<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <title><%= content_for(:title) || "PayRail — Real-Time Payment Engine & Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (CDN + Local for zero-friction demo resilience) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace'],
            },
            colors: {
              brand: {
                50: '#eef2ff',
                100: '#e0e7ff',
                400: '#818cf8',
                500: '#6366f1',
                600: '#4f46e5',
                700: '#4338ca',
                900: '#312e81',
              }
            }
          }
        }
      }
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#0B0F19] text-slate-100 selection:bg-brand-500 selection:text-white">
    <!-- Top Navigation Header -->
    <header class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Logo & Live Engine Badge -->
        <div class="flex items-center space-x-6">
          <a href="<%= logged_in? ? dashboard_path : root_path %>" class="flex items-center space-x-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">PayRail</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse mr-1"></span> ENGINE v1.0
                </span>
              </div>
            </div>
          </a>

          <% if logged_in? %>
            <!-- Primary Navigation Links -->
            <nav class="hidden md:flex items-center space-x-1 text-sm font-medium">
              <a href="<%= dashboard_path %>" class="px-3 py-1.5 rounded-lg <%= current_page?(dashboard_path) ? 'bg-slate-800 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %> transition">
                Dashboard
              </a>
              <a href="<%= new_transfer_path %>" class="px-3 py-1.5 rounded-lg <%= current_page?(new_transfer_path) ? 'bg-slate-800 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %> transition">
                Send & Request
              </a>
              <a href="<%= cards_path %>" class="px-3 py-1.5 rounded-lg <%= current_page?(cards_path) ? 'bg-slate-800 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %> transition">
                Cards
              </a>
              <a href="<%= ledger_path %>" class="px-3 py-1.5 rounded-lg <%= current_page?(ledger_path) ? 'bg-slate-800 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %> transition flex items-center space-x-1">
                <span>Ledger</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-brand-500/20 text-brand-300 font-mono">ACID</span>
              </a>
              <a href="<%= developer_path %>" class="px-3 py-1.5 rounded-lg <%= current_page?(developer_path) ? 'bg-slate-800 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %> transition flex items-center space-x-1">
                <span>API & Docs</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">Recruiter</span>
              </a>
            </nav>
          <% end %>
        </div>

        <!-- Right Side: User Profile / Fast Action -->
        <div class="flex items-center space-x-3">
          <% if logged_in? %>
            <!-- Add Funds Modal Button -->
            <button onclick="document.getElementById('depositModal').classList.remove('hidden')" class="hidden sm:inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              <span>Add Funds</span>
            </button>

            <!-- Send Money Fast Button -->
            <a href="<%= new_transfer_path %>" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-brand-600 hover:bg-brand-500 text-white shadow-md shadow-brand-600/30 transition">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <span>Transfer</span>
            </a>

            <!-- User Dropdown / Badge -->
            <div class="flex items-center space-x-2 pl-2 border-l border-slate-800">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs text-white" style="background-color: <%= current_user.avatar_color %>">
                <%= current_user.name.first(2).upcase %>
              </div>
              <div class="hidden lg:block text-left">
                <div class="text-xs font-semibold text-white leading-tight"><%= current_user.name %></div>
                <div class="text-[11px] font-mono text-brand-400"><%= current_user.payrail_tag %></div>
              </div>
              <%= button_to logout_path, method: :delete, class: "p-1.5 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition", title: "Sign Out" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
              <% end %>
            </div>
          <% else %>
            <a href="<%= login_path %>" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white transition">Sign In</a>
            <a href="<%= signup_path %>" class="px-4 py-2 text-sm font-semibold rounded-lg bg-brand-600 hover:bg-brand-500 text-white shadow-md transition">Create Account</a>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Flash Alerts Container -->
    <% if flash[:notice].present? %>
      <div class="bg-emerald-500/10 border-b border-emerald-500/20 px-4 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between text-sm text-emerald-400 font-medium">
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><%= flash[:notice] %></span>
          </div>
        </div>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="bg-rose-500/10 border-b border-rose-500/20 px-4 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between text-sm text-rose-400 font-medium">
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-rose-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span><%= flash[:alert] %></span>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Top-up / Add Funds Modal Dialog -->
    <% if logged_in? %>
      <div id="depositModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
          <button onclick="document.getElementById('depositModal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <div class="flex items-center space-x-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">Add Funds to Wallet</h3>
              <p class="text-xs text-slate-400">Simulate external payment rail deposit</p>
            </div>
          </div>

          <%= form_with url: deposits_path, method: :post, local: true, class: "space-y-4" do |f| %>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Deposit Amount (USD)</label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-slate-400 font-bold">$</span>
                <%= f.number_field :amount, step: 0.01, min: 1, value: 500.00, required: true, class: "w-full pl-8 pr-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white font-mono font-semibold focus:outline-none focus:border-brand-500" %>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Payment Rail Source</label>
              <%= f.select :payment_method, [
                ["Instant ACH Bank Transfer (Free)", "instant_ach"],
                ["Visa / Mastercard Debit Rail", "card_rail"],
                ["FedNow / Wire Settlement", "wire_transfer"]
              ], {}, class: "w-full px-3 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-brand-500" %>
            </div>

            <div class="pt-2">
              <%= f.submit "Complete Deposit Credit", class: "w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl shadow-lg shadow-emerald-600/20 transition cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/60 py-6 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4">
        <div class="flex items-center space-x-2">
          <span class="font-bold text-white">PayRail</span>
          <span>&copy; <%= Time.current.year %> Enterprise Double-Entry Payment Ledger.</span>
        </div>
        <div class="flex items-center space-x-4">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
            Pessimistic Row Locking (<span class="text-amber-400">with_lock</span>)
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
            Idempotency-Key
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
            Debits == Credits Invariant
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
