<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F5F7FA] text-slate-800">
  <head>
    <title><%= content_for(:title) || "PayRail — Authentication & Background Jobs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #F5F7FA; color: #0F172A; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#F5F7FA] text-[#0F172A] antialiased">
    
    <!-- Deep Navy Navigation Header -->
    <header class="bg-[#003087] text-white shadow-md sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Left: Logo -->
        <div class="flex items-center space-x-6">
          <a href="<%= logged_in? ? dashboard_path : login_path %>" class="flex items-center space-x-2.5">
            <div class="w-9 h-9 rounded-xl bg-white flex items-center justify-center shadow-sm">
              <span class="text-xl font-black italic tracking-tighter text-[#003087]">P</span>
              <span class="text-xl font-black italic tracking-tighter text-[#0070BA] -ml-1">R</span>
            </div>
            <span class="text-xl font-extrabold tracking-tight text-white">PayRail</span>
          </a>
        </div>

        <!-- Right: Auth Actions -->
        <div class="flex items-center space-x-4">
          <% if logged_in? %>
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-full bg-white text-[#003087] font-bold text-xs flex items-center justify-center shadow-sm">
                <%= current_user.name.first(2).upcase %>
              </div>
              <div class="hidden sm:block text-left leading-tight">
                <div class="text-xs font-bold text-white"><%= current_user.name %></div>
                <div class="text-[11px] text-slate-300 font-mono"><%= current_user.payrail_tag %></div>
              </div>
              <%= button_to logout_path, method: :delete, class: "ml-2 px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-xs font-bold text-white transition cursor-pointer" do %>
                Log Out
              <% end %>
            </div>
          <% else %>
            <a href="<%= login_path %>" class="px-4 py-2 text-sm font-bold text-white hover:text-slate-200 transition">Log In</a>
            <a href="<%= signup_path %>" class="px-4 py-2 text-sm font-bold rounded-full bg-[#0070BA] hover:bg-[#005EA6] text-white shadow-sm transition">Sign Up</a>
          <% end %>
        </div>

      </div>
    </header>

    <!-- Flash Notices & Alerts -->
    <% if flash[:notice].present? %>
      <div class="bg-emerald-50 border-b border-emerald-200 px-4 py-3">
        <div class="max-w-5xl mx-auto flex items-center text-sm text-emerald-800 font-medium">
          <span><%= flash[:notice] %></span>
        </div>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="bg-rose-50 border-b border-rose-200 px-4 py-3">
        <div class="max-w-5xl mx-auto flex items-center text-sm text-rose-800 font-medium">
          <span><%= flash[:alert] %></span>
        </div>
      </div>
    <% end %>

    <!-- Main Body Container -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-6">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
        <span><strong class="text-slate-700">PayRail</strong> &bull; Ruby on Rails RESTful Auth, Sidekiq Jobs &amp; RSpec</span>
        <span class="font-mono">JWT &bull; Sidekiq-Cron &bull; ActionMailer</span>
      </div>
    </footer>

  </body>
</html>
