<div class="space-y-6">
  
  <!-- Developer Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">PayRail Developer Portal</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-[#0070BA] border border-blue-200">
          REST API v1
        </span>
      </div>
      <p class="text-xs text-slate-500 mt-0.5">Integration keys, interactive testing console, and webhook event monitoring</p>
    </div>
  </div>

  <!-- Interactive Test Console (Stripe/PayPal style) -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Interactive API Console</h2>
        <p class="text-xs text-slate-500">Dispatch live authenticated requests to the PayRail REST Engine</p>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="runApiTest('wallets')" class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-mono font-bold transition">
          GET /wallets
        </button>
        <button onclick="runApiTest('transfers')" class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-mono font-bold transition">
          GET /transfers
        </button>
        <button onclick="runApiTest('analytics')" class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-mono font-bold transition">
          GET /analytics
        </button>
        <button onclick="runApiTest('handbook')" class="px-4 py-1.5 rounded-full bg-blue-50 hover:bg-blue-100 text-[#0070BA] text-xs font-mono font-bold border border-blue-200 transition">
          Verify Handbook (Q1-Q169)
        </button>
      </div>
    </div>

    <!-- Clean Code Block Console -->
    <div class="rounded-xl bg-slate-900 p-4 font-mono text-xs overflow-x-auto shadow-inner">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3 text-slate-400">
        <span class="text-xs text-emerald-400 font-bold" id="consoleEndpoint">GET /api/v1/wallets</span>
        <span class="text-[11px] text-slate-400" id="consoleStatus">Status: 200 OK</span>
      </div>
      <pre id="apiConsoleOutput" class="text-slate-200 leading-relaxed max-h-72 overflow-y-auto">// Click one of the buttons above to test live endpoints
// Endpoint: http://localhost:3000/api/v1/wallets
// Headers: Authorization: Bearer &lt;TOKEN&gt;</pre>
    </div>
  </div>

  <!-- Credentials & Curl Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- API Credentials -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
      <h3 class="text-sm font-bold text-slate-900">API Credentials</h3>
      
      <div>
        <label class="block text-xs font-bold text-slate-600 mb-1">Live Secret API Key</label>
        <input type="text" readonly value="<%= @api_key %>" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl font-mono text-xs text-slate-800 select-all" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-600 mb-1">Session JWT Token (24h)</label>
        <input type="text" readonly value="<%= @jwt_token %>" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl font-mono text-[11px] text-slate-600 truncate select-all" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-600 mb-1">Base Endpoint</label>
        <input type="text" readonly value="<%= @api_base_url %>" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl font-mono text-xs text-slate-700" />
      </div>
    </div>

    <!-- Ready-to-run Curl Commands -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
      <h3 class="text-sm font-bold text-slate-900">cURL Quick Reference</h3>

      <div class="space-y-3 font-mono text-xs">
        <div>
          <span class="text-[11px] font-sans font-bold text-slate-600 block mb-1">Idempotent P2P Transfer:</span>
          <div class="p-3 rounded-xl bg-slate-900 text-slate-200 text-[11px] overflow-x-auto">
curl -X POST <%= @api_base_url %>/transfers \<br>
&nbsp;&nbsp;-H "Authorization: Bearer <%= @jwt_token[0..18] %>..." \<br>
&nbsp;&nbsp;-H "Idempotency-Key: <%= SecureRandom.hex(6) %>" \<br>
&nbsp;&nbsp;-H "Content-Type: application/json" \<br>
&nbsp;&nbsp;-d '{"recipient": "$alice", "amount": 25.00}'
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Outgoing Webhooks -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-sm font-bold text-slate-900">Webhook Deliveries Log</h3>
        <p class="text-xs text-slate-500">Live payment events dispatched to listener webhooks</p>
      </div>
      <span class="text-xs font-bold text-emerald-600">Dispatcher Active</span>
    </div>

    <% if @recent_deliveries.any? %>
      <div class="divide-y divide-slate-100">
        <% @recent_deliveries.each do |delivery| %>
          <div class="py-3 flex items-center justify-between text-xs">
            <div class="flex items-center space-x-3">
              <span class="px-2 py-0.5 rounded font-mono font-bold bg-blue-50 text-[#0070BA]">
                <%= delivery.event_type %>
              </span>
              <span class="text-slate-600 font-mono text-[11px] truncate max-w-sm">
                <%= delivery.payload.truncate(60) %>
              </span>
            </div>
            <div class="flex items-center space-x-3 text-slate-500 font-mono text-[11px]">
              <span class="font-bold text-emerald-600">HTTP <%= delivery.response_code %> OK</span>
              <span><%= delivery.created_at.strftime("%H:%M:%S") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-6 text-xs text-slate-400">
        No webhook deliveries logged yet.
      </div>
    <% end %>
  </div>

</div>

<script>
  function runApiTest(endpoint) {
    const consoleOutput = document.getElementById('apiConsoleOutput');
    const endpointLabel = document.getElementById('consoleEndpoint');
    const statusLabel = document.getElementById('consoleStatus');

    endpointLabel.textContent = `GET /api/v1/${endpoint}`;
    statusLabel.textContent = "Status: EXECUTING...";
    consoleOutput.textContent = "Sending request to PayRail API Engine...";

    fetch('/developer/test_api', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ endpoint: endpoint })
    })
    .then(res => res.json())
    .then(data => {
      statusLabel.textContent = "Status: 200 OK";
      consoleOutput.textContent = JSON.stringify(data, null, 2);
    })
    .catch(err => {
      statusLabel.textContent = "Status: ERROR";
      consoleOutput.textContent = "Error executing API call: " + err.message;
    });
  }
</script>
