<div class="space-y-6">
  
  <!-- Header & Filters -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Activity</h1>
      <p class="text-xs text-slate-500 mt-0.5">Your official account statements and transaction history</p>
    </div>

    <div class="flex items-center space-x-2">
      <a href="<%= ledger_path %>" class="px-4 py-1.5 rounded-full text-xs font-semibold <%= @filter_type.blank? ? 'bg-slate-900 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %> transition">
        All
      </a>
      <a href="<%= ledger_path(entry_type: 'credit') %>" class="px-4 py-1.5 rounded-full text-xs font-semibold <%= @filter_type == 'credit' ? 'bg-[#0070BA] text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %> transition">
        Received (+)
      </a>
      <a href="<%= ledger_path(entry_type: 'debit') %>" class="px-4 py-1.5 rounded-full text-xs font-semibold <%= @filter_type == 'debit' ? 'bg-[#0070BA] text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %> transition">
        Sent (-)
      </a>
    </div>
  </div>

  <!-- Accounting Ledger Summary Card (Clean & Trustworthy) -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <h2 class="text-sm font-bold text-slate-800">Double-Entry Ledger Audit &bull; Zero Balance Variance</h2>
      </div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
        100% RECONCILED &amp; BALANCED
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-sans">
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="text-slate-500 font-medium block mb-1">Total Journal Credits</span>
        <span class="text-base font-bold text-emerald-600 font-mono">+<%= format("$%.2f", @total_credits_cents / 100.0) %></span>
      </div>
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="text-slate-500 font-medium block mb-1">Total Journal Debits</span>
        <span class="text-base font-bold text-slate-800 font-mono">-<%= format("$%.2f", @total_debits_cents / 100.0) %></span>
      </div>
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="text-slate-500 font-medium block mb-1">Reconciled Balance</span>
        <span class="text-base font-bold text-slate-900 font-mono"><%= @wallet.formatted_balance %></span>
      </div>
    </div>
  </div>

  <!-- Activity Table -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="text-slate-500 bg-slate-50/70 border-b border-slate-200 uppercase tracking-wider text-[11px]">
            <th class="py-3 px-4 font-bold">Date</th>
            <th class="py-3 px-4 font-bold">Type</th>
            <th class="py-3 px-4 font-bold">Description</th>
            <th class="py-3 px-4 font-bold">Transaction Reference</th>
            <th class="py-3 px-4 font-bold text-right">Amount</th>
            <th class="py-3 px-4 font-bold text-right">Balance After</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @ledger_entries.each do |entry| %>
            <tr class="hover:bg-slate-50 transition cursor-pointer" onclick="window.location='<%= transfer_path(entry.transfer.reference_id) %>'">
              <td class="py-3.5 px-4 text-slate-600 font-medium">
                <%= entry.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= entry.debit? ? 'bg-slate-100 text-slate-700' : 'bg-emerald-50 text-emerald-700' %>">
                  <%= entry.entry_type %>
                </span>
              </td>
              <td class="py-3.5 px-4 font-bold text-slate-800 max-w-xs truncate">
                <%= entry.description %>
              </td>
              <td class="py-3.5 px-4 font-mono text-slate-500 text-[11px]">
                <%= entry.transfer.reference_id %>
              </td>
              <td class="py-3.5 px-4 text-right font-bold font-mono text-sm <%= entry.debit? ? 'text-slate-800' : 'text-emerald-600' %>">
                <%= entry.formatted_amount %>
              </td>
              <td class="py-3.5 px-4 text-right font-mono font-medium text-slate-600">
                <%= entry.formatted_balance_after %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
