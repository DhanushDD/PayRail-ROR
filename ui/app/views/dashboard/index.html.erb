<div class="max-w-3xl mx-auto space-y-6">
  <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-white font-bold text-lg shadow-sm" style="background-color: <%= @user.avatar_color %>">
          <%= @user.name.first(2).upcase %>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Welcome, <%= @user.name %>!</h1>
          <p class="text-xs text-slate-500 font-mono mt-0.5"><%= @user.email %> &bull; <%= @user.payrail_tag %></p>
        </div>
      </div>

      <div>
        <%= button_to logout_path, method: :delete, class: "px-5 py-2.5 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs transition cursor-pointer" do %>
          Sign Out
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Account Role &amp; Status</div>
        <div class="text-sm font-bold text-slate-800 mt-1 capitalize"><%= @user.role %> (<%= @user.kyc_verified? ? "Verified" : "Pending" %>)</div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Sign-In Activity</div>
        <div class="text-sm font-bold text-slate-800 mt-1">
          <%= @user.sign_in_count %> logins
          <% if @user.last_sign_in_at %>
            <span class="text-xs font-normal text-slate-500">(Last: <%= @user.last_sign_in_at.strftime("%b %d, %H:%M") %>)</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-slate-100 space-y-4">
      <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">RESTful API Credentials &amp; Background Jobs</h2>
      
      <div>
        <label class="block text-xs font-semibold text-slate-500 mb-1">API Key (`X-API-Key`)</label>
        <code class="block w-full p-3 rounded-xl bg-slate-900 text-emerald-400 font-mono text-xs overflow-x-auto"><%= @user.api_key %></code>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 mb-1">Active JWT Bearer Token</label>
        <code class="block w-full p-3 rounded-xl bg-slate-900 text-sky-400 font-mono text-xs break-all"><%= @jwt_token %></code>
      </div>

      <div class="p-4 rounded-2xl bg-blue-50/60 border border-blue-200 text-xs text-slate-700 space-y-1.5">
        <div class="font-bold text-[#003087]">Active Background Jobs (Sidekiq &amp; Cron):</div>
        <ul class="list-disc pl-4 space-y-1">
          <li><code class="font-mono font-semibold">WelcomeEmailJob</code> — Triggered asynchronously on <code class="font-mono">sign_up</code> via ActionMailer.</li>
          <li><code class="font-mono font-semibold">LoginNotificationJob</code> — Triggered asynchronously on <code class="font-mono">login</code> to update sign-in metrics and send security alert.</li>
          <li><code class="font-mono font-semibold">SessionCleanupJob</code> — Scheduled daily via <code class="font-mono">sidekiq-cron</code> (<code class="font-mono">config/schedule.yml</code>).</li>
        </ul>
      </div>
    </div>
  </div>
</div>
