<div class="space-y-6">
  <!-- Top Greeting & Wallet Summary -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
        Welcome back, <%= @user.name %>
      </h1>
      <p class="text-xs text-slate-500 mt-0.5 flex items-center space-x-2">
        <span>PayRail Account</span>
        <span>&bull;</span>
        <span class="font-mono text-[#0070BA] font-semibold"><%= @user.payrail_tag %></span>
        <span>&bull;</span>
        <span class="font-mono text-slate-500">Wallet: <%= @wallet.wallet_number %></span>
      </p>
    </div>
  </div>

  <!-- Main 2-Column Payment App Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- Left Column (7 cols): Wallet Balance + Recent Payment Activity -->
    <div class="lg:col-span-7 space-y-6">

      <!-- 1. PayRail Balance Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center space-x-2">
            <div class="w-6 h-6 rounded-full bg-blue-50 text-[#0070BA] flex items-center justify-center font-bold text-xs">$</div>
            <h2 class="text-xs font-bold text-slate-600 uppercase tracking-wider">PayRail Wallet Balance</h2>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-400"><%= @wallet.currency %></span>
        </div>

        <div class="flex items-baseline space-x-2 my-3">
          <span class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
            <%= @wallet.formatted_balance %>
          </span>
          <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Available</span>
        </div>

        <!-- Quick Add Money Inline Form -->
        <div class="pt-4 mt-4 border-t border-slate-100">
          <%= form_with url: deposit_payments_path, method: :post, local: true, class: "flex flex-wrap items-center gap-2" do |f| %>
            <div class="relative flex-1 min-w-[140px]">
              <span class="absolute left-3.5 top-2.5 text-slate-400 font-bold text-sm">$</span>
              <%= f.number_field :amount, step: 0.01, min: 1, value: 250.00, required: true, class: "w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm font-bold font-mono text-slate-900 focus:outline-none focus:border-[#0070BA] focus:bg-white" %>
            </div>
            <%= f.hidden_field :description, value: "Instant Wallet Top-Up" %>
            <%= f.submit "+ Add Money to Wallet", class: "px-5 py-2.5 rounded-full text-xs font-bold bg-[#003087] hover:bg-[#0070BA] text-white shadow-sm transition cursor-pointer" %>
          <% end %>
        </div>
      </div>

      <!-- 2. Recent Payments & Transfers Activity -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-slate-900">Recent Payment Activity</h3>
            <p class="text-xs text-slate-500 mt-0.5">Instant P2P transfers and wallet deposits</p>
          </div>
          <span class="text-xs font-mono text-slate-400"><%= @payments.count %> transactions</span>
        </div>

        <% if @payments.any? %>
          <div class="divide-y divide-slate-100">
            <% @payments.each do |payment| %>
              <% is_credit = payment.credit_for?(@user) %>
              <div class="p-4 sm:px-6 hover:bg-slate-50/80 transition flex items-center justify-between">
                <div class="flex items-center space-x-3.5">
                  <div class="w-10 h-10 rounded-full <%= is_credit ? 'bg-emerald-50 text-emerald-600' : 'bg-blue-50 text-[#0070BA]' %> flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= is_credit ? "+" : "→" %>
                  </div>
                  <div>
                    <div class="text-sm font-bold text-slate-900">
                      <% if payment.payment_type == "deposit" %>
                        Added Funds to Wallet
                      <% elsif is_credit %>
                        From <%= payment.sender&.name || "PayRail User" %> (<span class="font-mono text-xs text-slate-500"><%= payment.sender&.payrail_tag %></span>)
                      <% else %>
                        To <%= payment.recipient.name %> (<span class="font-mono text-xs text-slate-500"><%= payment.recipient.payrail_tag %></span>)
                      <% end %>
                    </div>
                    <div class="text-xs text-slate-500 flex items-center space-x-2 mt-0.5">
                      <span class="font-mono text-[11px] text-slate-400"><%= payment.reference_id %></span>
                      <span>&bull;</span>
                      <span><%= payment.description %></span>
                      <span>&bull;</span>
                      <span><%= payment.created_at.strftime("%b %d, %H:%M") %></span>
                    </div>
                  </div>
                </div>

                <div class="text-right">
                  <div class="text-sm font-extrabold font-mono <%= is_credit ? 'text-emerald-600' : 'text-slate-900' %>">
                    <%= is_credit ? "+" : "-" %><%= payment.formatted_amount %>
                  </div>
                  <div class="text-[11px] text-slate-400 uppercase font-semibold">
                    <%= payment.status %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-10 text-center text-xs text-slate-400">
            No payments yet. Use the Send Money box to make your first transfer!
          </div>
        <% end %>
      </div>

    </div>

    <!-- Right Column (5 cols): Send Money Form + Quick Peers + API / Sidekiq Status -->
    <div class="lg:col-span-5 space-y-6">

      <!-- 1. Send Money Card -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
        <h3 class="text-base font-bold text-slate-900">Send Money</h3>
        <p class="text-xs text-slate-500 mt-0.5 mb-4">Instant P2P transfer by $tag or email (triggers Sidekiq receipt job)</p>

        <% if @peers.any? %>
          <div class="mb-4">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Quick Select Recipient</div>
            <div class="flex flex-wrap gap-2">
              <% @peers.each do |peer| %>
                <button type="button" onclick="document.getElementById('recipient_input').value='<%= peer.payrail_tag %>'" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-slate-100 hover:bg-blue-50 text-xs font-semibold text-slate-700 hover:text-[#0070BA] transition cursor-pointer">
                  <span><%= peer.name.split.first %></span>
                  <span class="font-mono text-[11px] text-[#0070BA]"><%= peer.payrail_tag %></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= form_with url: payments_path, method: :post, local: true, class: "space-y-3.5" do |f| %>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Recipient ($tag or Email)</label>
            <%= f.text_field :recipient, id: "recipient_input", placeholder: "e.g. $alice or alice@payrail.io", required: true, class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-xs font-mono placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:bg-white" %>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Amount (USD)</label>
            <div class="relative">
              <span class="absolute left-3.5 top-2.5 text-slate-400 font-bold text-sm">$</span>
              <%= f.number_field :amount, step: 0.01, min: 1.00, placeholder: "50.00", required: true, class: "w-full pl-8 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-base font-bold font-mono placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:bg-white" %>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Note</label>
            <%= f.text_field :description, placeholder: "Dinner, coffee, rent...", class: "w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-xs placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:bg-white" %>
          </div>

          <div class="pt-1">
            <%= f.submit "Send Payment Now", class: "w-full py-3 bg-[#0070BA] hover:bg-[#003087] text-white font-bold rounded-full text-xs shadow-sm transition cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- 2. API Key & Sidekiq Background Jobs Summary -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-3">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Developer &amp; Sidekiq Status</h3>
        <div>
          <div class="text-[11px] font-semibold text-slate-500 mb-1">API Key (`X-API-Key`)</div>
          <code class="block w-full p-2.5 rounded-xl bg-slate-900 text-emerald-400 font-mono text-[11px] overflow-x-auto"><%= @user.api_key %></code>
        </div>
        <div class="text-xs text-slate-600 space-y-1 pt-1">
          <div>&bull; <code class="font-mono text-[11px] font-semibold">WelcomeEmailJob</code> (on Sign Up)</div>
          <div>&bull; <code class="font-mono text-[11px] font-semibold">LoginNotificationJob</code> (on Login)</div>
          <div>&bull; <code class="font-mono text-[11px] font-semibold">PaymentNotificationJob</code> (on Payment Transfer)</div>
          <div>&bull; <code class="font-mono text-[11px] font-semibold">SessionCleanupJob</code> (Sidekiq-Cron Daily)</div>
        </div>
      </div>

    </div>

  </div>
</div>
