<div class="space-y-6">
  
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Wallet</h1>
      <p class="text-xs text-slate-500 mt-0.5">Manage your PayRail virtual cards and linked payment methods</p>
    </div>

    <div>
      <button onclick="document.getElementById('newCardModal').classList.remove('hidden')" class="px-5 py-2 rounded-full text-xs font-bold bg-[#0070BA] hover:bg-[#003087] text-white shadow-sm transition flex items-center space-x-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Link / Issue Card</span>
      </button>
    </div>
  </div>

  <!-- Wallet Grid (PayPal Style) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @cards.each do |card| %>
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between space-y-6">
        
        <!-- Physical-looking Digital Card Graphic -->
        <div class="bg-gradient-to-tr from-[#002266] via-[#003087] to-[#0070BA] rounded-2xl p-5 text-white shadow-md relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black tracking-widest uppercase">PayRail</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/20 font-bold uppercase"><%= card.tier %></span>
          </div>

          <div class="my-3">
            <div class="w-8 h-6 rounded bg-amber-300/80 border border-amber-400/60 mb-2"></div>
            <div class="text-base font-mono font-bold tracking-widest text-white">
              <%= card.masked_number %>
            </div>
          </div>

          <div class="flex items-end justify-between text-xs pt-2 border-t border-white/20">
            <div>
              <div class="text-[9px] uppercase tracking-wider text-slate-200">Cardholder</div>
              <div class="font-bold text-white text-xs"><%= card.cardholder_name %></div>
            </div>
            <div>
              <div class="text-[9px] uppercase tracking-wider text-slate-200">Expires</div>
              <div class="font-mono font-bold text-xs"><%= card.formatted_expiry %></div>
            </div>
            <div>
              <div class="text-[9px] uppercase tracking-wider text-slate-200">CVV</div>
              <div class="font-mono font-bold text-xs"><%= card.cvv %></div>
            </div>
          </div>
        </div>

        <!-- Card Meta Info & Controls -->
        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Card Status:</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold <%= card.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>">
              <span class="w-1.5 h-1.5 rounded-full <%= card.active? ? 'bg-emerald-500' : 'bg-rose-500' %> mr-1.5"></span>
              <%= card.status.titleize %>
            </span>
          </div>

          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Monthly Spending Limit:</span>
            <span class="font-bold text-slate-800"><%= card.formatted_monthly_limit %></span>
          </div>

          <div class="pt-2">
            <%= button_to toggle_freeze_card_path(card), method: :patch, class: "w-full py-2.5 rounded-full text-xs font-bold #{card.active? ? 'border border-slate-300 hover:bg-slate-50 text-slate-700' : 'bg-rose-600 hover:bg-rose-700 text-white'} transition" do %>
              <%= card.active? ? "Lock Card (Freeze)" : "Unlock Card" %>
            <% end %>
          </div>
        </div>

      </div>
    <% end %>

    <!-- Linked Bank Card Placeholder -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center space-x-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900">Chase Bank</h3>
            <p class="text-xs text-slate-500">Checking •••• 4021</p>
          </div>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Linked for instant zero-fee top-ups and automatic transfer withdrawals.
        </p>
      </div>

      <div class="pt-4 border-t border-slate-100">
        <span class="text-xs font-bold text-emerald-600">Primary Linked Bank</span>
      </div>
    </div>
  </div>

</div>

<!-- Issue Card Modal -->
<div id="newCardModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-3xl max-w-md w-full p-8 shadow-2xl relative">
    <button onclick="document.getElementById('newCardModal').classList.add('hidden')" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600 p-1">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <h3 class="text-xl font-bold text-slate-900 mb-1">Issue New Virtual Card</h3>
    <p class="text-xs text-slate-500 mb-5">Generated instantly and linked to your PayRail balance</p>

    <%= form_with url: cards_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Cardholder Name</label>
        <%= f.text_field :cardholder_name, value: current_user.name.upcase, required: true, class: "w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-slate-900 text-xs font-semibold focus:outline-none focus:border-[#0070BA]" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Card Tier</label>
        <%= f.select :tier, [["PayRail Signature Blue", "Signature"], ["Black Metal Edition", "Black Metal"], ["Platinum Horizon", "Platinum"]], {}, class: "w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-slate-900 text-xs focus:outline-none focus:border-[#0070BA]" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Monthly Limit ($)</label>
        <%= f.number_field :monthly_limit, value: 5000.00, step: 100, min: 100, required: true, class: "w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-slate-900 text-xs font-mono font-bold focus:outline-none focus:border-[#0070BA]" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Issue Card Now", class: "w-full py-3.5 bg-[#0070BA] hover:bg-[#003087] text-white font-bold rounded-full text-xs shadow-sm transition cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
