<div class="max-w-4xl mx-auto py-6">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 shadow-xl shadow-brand-500/20 mb-4">
      <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h1 class="text-3xl font-extrabold text-white tracking-tight">Sign in to PayRail</h1>
    <p class="text-sm text-slate-400 mt-2 max-w-md mx-auto">
      Enterprise Real-Time Payment Engine & Double-Entry Accounting Ledger
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Recruiter 1-Click Fast Login Showcase (Accenture Highlight!) -->
    <div class="lg:col-span-7 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-brand-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-1">
            ACCENTURE INTERVIEW SHOWCASE
          </span>
          <h2 class="text-lg font-bold text-white">1-Click Recruiter Demo Access</h2>
          <p class="text-xs text-slate-400">Select any pre-seeded persona to test live real-time payments immediately:</p>
        </div>
      </div>

      <div class="space-y-3">
        <% @demo_users.each do |user| %>
          <%= form_with url: login_path, method: :post, local: true do |f| %>
            <%= f.hidden_field :demo_user_id, value: user.id %>
            <button type="submit" class="w-full text-left p-3.5 rounded-xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 hover:border-brand-500/50 transition group flex items-center justify-between">
              <div class="flex items-center space-x-3.5">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm text-white shadow-sm flex-shrink-0" style="background-color: <%= user.avatar_color %>">
                  <%= user.name.first(2).upcase %>
                </div>
                <div>
                  <div class="flex items-center space-x-2">
                    <span class="text-sm font-semibold text-white group-hover:text-brand-300 transition"><%= user.name %></span>
                    <span class="text-[11px] font-mono text-slate-400"><%= user.payrail_tag %></span>
                  </div>
                  <div class="text-xs text-slate-400 flex items-center space-x-2 mt-0.5">
                    <span>Role: <strong class="text-slate-300 capitalize"><%= user.role %></strong></span>
                    <span>&bull;</span>
                    <span>Balance: <strong class="text-emerald-400 font-mono"><%= user.formatted_total_balance %></strong></span>
                  </div>
                </div>
              </div>
              <div class="flex items-center space-x-1 text-xs font-semibold text-brand-400 group-hover:translate-x-1 transition-transform">
                <span>Enter</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </button>
          <% end %>
        <% end %>
      </div>

      <div class="mt-5 p-3 rounded-xl bg-slate-950/50 border border-slate-800/80 text-[11px] text-slate-400 flex items-center space-x-2">
        <svg class="w-4 h-4 text-brand-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Accounts come pre-loaded with double-entry ledger histories, virtual cards, and active balances for instantaneous demoing.</span>
      </div>
    </div>

    <!-- Standard Login Form -->
    <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
      <h2 class="text-base font-bold text-white mb-1">Manual Account Sign In</h2>
      <p class="text-xs text-slate-400 mb-5">Sign in with your email or PayRail tag</p>

      <%= form_with url: login_path, method: :post, local: true, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Email or PayRail Tag</label>
          <%= f.text_field :email_or_tag, placeholder: "e.g. demo@payrail.io or $accenture_demo", required: true, class: "w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-brand-500" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Password</label>
            <span class="text-[11px] text-slate-400">demo: <code class="text-slate-300 font-mono">password123</code></span>
          </div>
          <%= f.password_field :password, required: true, class: "w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-brand-500" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Sign In to PayRail", class: "w-full py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl shadow-lg shadow-brand-600/30 transition cursor-pointer text-sm" %>
        </div>
      <% end %>

      <div class="mt-6 pt-5 border-t border-slate-800 text-center">
        <p class="text-xs text-slate-400">
          New to PayRail?
          <a href="<%= signup_path %>" class="text-brand-400 hover:text-brand-300 font-semibold ml-1">Create Account & Claim $1,000</a>
        </p>
      </div>
    </div>

  </div>
</div>
