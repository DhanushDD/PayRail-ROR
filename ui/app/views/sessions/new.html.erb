<div class="max-w-md mx-auto py-8 sm:py-12">
  
  <!-- PayPal-Style Clean White Authentication Card -->
  <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm">
    
    <!-- PayPal Monogram & Title -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center space-x-1 mb-3">
        <div class="w-10 h-10 rounded-2xl bg-[#003087] flex items-center justify-center shadow-sm">
          <span class="text-xl font-black italic tracking-tighter text-white">P</span>
          <span class="text-xl font-black italic tracking-tighter text-[#00BAF2] -ml-1">R</span>
        </div>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Log in to PayRail</h1>
      <p class="text-xs text-slate-500 mt-1">Safe, secure real-time digital payments</p>
    </div>

    <!-- Login Form -->
    <%= form_with url: login_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email address or $tag</label>
        <%= f.text_field :email_or_tag, placeholder: "e.g. demo@payrail.io or $accenture_demo", required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Password</label>
          <span class="text-[11px] text-slate-400">demo: <code class="font-mono text-slate-600">password123</code></span>
        </div>
        <%= f.password_field :password, required: true, class: "w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm focus:outline-none focus:border-[#0070BA] focus:ring-2 focus:ring-blue-100 transition" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Log In", class: "w-full py-3.5 bg-[#0070BA] hover:bg-[#003087] text-white font-bold rounded-full shadow-sm text-sm transition cursor-pointer" %>
      </div>
    <% end %>

    <!-- Divider -->
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-slate-200"></div>
      </div>
      <div class="relative flex justify-center text-xs uppercase">
        <span class="bg-white px-3 text-slate-400 font-semibold">or</span>
      </div>
    </div>

    <!-- Sign Up Pill Button -->
    <div>
      <a href="<%= signup_path %>" class="w-full block text-center py-3 border-2 border-slate-300 hover:border-slate-400 text-slate-700 font-bold rounded-full text-xs transition">
        Sign Up for Free
      </a>
    </div>

  </div>

  <!-- Reviewer / Recruiter Fast Switch Drawer (Clean & Professional) -->
  <div class="mt-6 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Reviewer Quick Access</span>
      <span class="text-[11px] text-slate-400">1-Tap Login</span>
    </div>
    
    <div class="space-y-2">
      <% @demo_users.each do |user| %>
        <%= form_with url: login_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :demo_user_id, value: user.id %>
          <button type="submit" class="w-full text-left p-3 rounded-xl hover:bg-slate-50 border border-slate-100 hover:border-slate-200 transition group flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs text-white shadow-xs" style="background-color: <%= user.avatar_color %>">
                <%= user.name.first(2).upcase %>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-[#0070BA] transition"><%= user.name %></div>
                <div class="text-[11px] text-slate-500 font-mono"><%= user.payrail_tag %> &bull; <strong class="text-emerald-600 font-sans"><%= user.formatted_total_balance %></strong></div>
              </div>
            </div>
            <span class="text-xs font-semibold text-[#0070BA] group-hover:underline">Select &rarr;</span>
          </button>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
